{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./styles/globals.css",
    "functions": ["cn"]
  },
  "ignorePatterns": [
    "package.json",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    "tsconfig.tsbuildinfo",
    "docs/**",
    "public/**",
    "dist/**",
    ".next/**",
    "node_modules/**"
  ]
}
